PORT=4000
CLIENT_ORIGIN=http://localhost:5180
DATABASE_URL=postgresql://localhost:5432/freelancehq
JWT_SECRET=change-me-to-a-long-random-string

# --- One-time codes (OTP) for sign-up -------------------------------------------------
# EMAIL: set these to send real emails through any SMTP service (Resend, Brevo, Mailtrap,
# Gmail app password...). Leave SMTP_HOST empty in development and the code is printed in
# the API terminal (and shown in the app) instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=FreelanceHQ <no-reply@yourdomain.com>

# SMS: Twilio works in 180+ countries. Use a Messaging Service SID (recommended, it picks the
# best sender per country) OR a single TWILIO_FROM number. Leave empty to use dev mode.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_FROM=

# --- AI proposal writer ---------------------------------------------------------------
# Get a key at https://console.anthropic.com (Settings -> API keys). Without it, everything else
# works; only the "Write it with AI" button is unavailable.
ANTHROPIC_API_KEY=
# Optional. Defaults to claude-opus-5-5. A cheaper/faster model can be set here.
ANTHROPIC_MODEL=
# Optional. How many AI proposals one person may generate per hour (cost control). Default 10.
AI_PROPOSALS_PER_HOUR=10

# --- Documents (file uploads) ---------------------------------------------------------
# Where uploaded files are stored. "local" saves them in server/uploads/ (development only:
# hosts like Vercel do not keep files written to disk). A cloud driver (Cloudflare R2 / S3)
# slots in behind the same interface in src/storage.ts.
STORAGE_DRIVER=local
# Optional: folder for the local driver. Defaults to server/uploads
UPLOADS_DIR=

# --- Links in emails ------------------------------------------------------------------
# The public address of the web app, used to build links such as /i/<token> in emails.
# Defaults to CLIENT_ORIGIN.
APP_URL=

# --- Online payments (Paystack) ---------------------------------------------------------
# Each freelancer connects THEIR OWN Paystack account in Settings; their secret key is stored
# encrypted with this key. 32 random bytes, base64. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Never change or lose it: keys already stored could no longer be decrypted.
ENCRYPTION_KEY=
# Optional, for tests only: point at a fake Paystack. Defaults to https://api.paystack.co
PAYSTACK_API_BASE=
